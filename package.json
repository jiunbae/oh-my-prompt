{
  "name": "oh-my-prompt",
  "version": "2026.715.1",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "bin": {
    "omp": "bin/omp"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "setup": "docker compose up -d && bash -c 'for i in $(seq 1 30); do docker compose exec -T db pg_isready -q && break || sleep 1; done' && pnpm db:migrate",
    "build:worker": "node scripts/build-worker.mjs",
    "worker": "node dist/worker.cjs",
    "build:cli": "bash scripts/build-cli.sh",
    "verify:cli": "node packages/omp-cli/scripts/verify-build.js",
    "check-contrast": "node scripts/check-contrast.mjs",
    "check-i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.90.20",
    "@trpc/client": "^11.9.0",
    "@trpc/react-query": "^11.9.0",
    "@trpc/server": "^11.9.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.67.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.9.2",
    "lucide-react": "^0.563.0",
    "next": "16.3.0",
    "next-intl": "^4.12.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "picocolors": "^1.1.1",
    "pino": "^10.3.0",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.7.0",
    "sql.js": "^1.14.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "toml": "^3.0.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "better-sqlite3": "12.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  }
}
