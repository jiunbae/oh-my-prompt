# Database
DATABASE_URL=postgresql://prompt:changeme@localhost:5432/prompts
POSTGRES_PASSWORD=changeme

# Session signing (generate with: openssl rand -hex 32)
SESSION_SECRET=your-session-secret-here

# Application (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Background jobs (BullMQ). When "true", scheduled extension work (digests,
# Slack summaries, alert evaluation) and webhook retries are enqueued to Redis
# and executed by the worker process (`pnpm worker` / dist/worker.cjs) instead
# of running inline in the web request. Requires REDIS_URL and a running worker.
QUEUE_ENABLED=false
# REDIS_URL=redis://localhost:6379
# Token that lets a system cron / k8s CronJob trigger POST
# /api/admin/scheduled-jobs/run (optional; the worker self-schedules).
# SCHEDULER_TOKEN=

# App-local date grouping/timezone for dashboards and insights
TZ=UTC
OMP_TIME_ZONE=UTC

# Email provider (smtp | resend | sendgrid)
EMAIL_PROVIDER=smtp
EMAIL_FROM=Oh My Prompt <noreply@example.com>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
SENDGRID_API_KEY=

# LLM insights (OpenAI-compatible local/vLLM servers can use provider=custom)
OMP_LLM_PROVIDER=custom
OMP_LLM_BASE_URL=http://localhost:8000/v1
OMP_LLM_MODEL=Qwen/Qwen3.5-122B-A10B-FP8
# Gemini key pool, as a JSON object keyed by contract label. Six free keys on six
# separate GCP projects = six independent quotas for the same model; the pool
# round-robins across them and parks a key when its own quota says to.
#
# A map, not a comma-separated list, on purpose: with a positional list one
# missing key silently shifts every label after it onto the wrong GCP account,
# and the usage dashboard then attributes quota to projects that never served it.
#
# Labels are fixed by the jiun-api usage contract, not by Vault field names; the
# number-to-account mapping is pinned in IaC docs/ai-api-keys-reference.md.
# paid-1 is a last resort: it is offered only after every free key is parked.
# GEMINI_API_KEYS={"free-1":"...","free-2":"...","free-3":"...","free-4":"...","free-5":"...","free-6":"...","paid-1":"..."}
OMP_LLM_MAX_TOKENS=1024
OMP_LLM_TEMPERATURE=0.7
OMP_LLM_ENABLE_THINKING=false
OMP_LLM_API_KEY=
# Forwarding headers are ignored by default. Set this only when the app is
# behind a known reverse proxy (for example, 1 for a single ingress controller).
TRUSTED_PROXY_HOPS=0
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# ── jiun-api LLM usage reporting ──────────────────────────────────
# Reports token/cost/latency metadata for every provider call to jiun-api.
# See docs/guides/llm-usage-reporting.md. Leave JIUN_USAGE_KEY empty to keep
# reporting off — a self-hosted install without a key sends nothing.
JIUN_USAGE_API_URL=https://api.jiun.dev
JIUN_USAGE_SERVICE_ID=oh-my-prompt
# Inject as a secret. Never commit it and never log it.
JIUN_USAGE_KEY=
# Contract credential LABEL (free-1..free-6, paid-1). Never an API key, and never
# a Vault field name — the value is published in a Prometheus label that anyone
# with dashboard access can read. A rotating pool supplies its own per-call label.
JIUN_USAGE_API_KEY_LABEL=
JIUN_USAGE_TIMEOUT_MS=5000
